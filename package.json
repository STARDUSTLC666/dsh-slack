{
  "name": "dsh-slack",
  "version": "0.6.1+trigger.1",
  "description": "dsh-slack 的 fork：在原有 Slack 工具之上增加收件箱触发器，命中 @ / 私信时唤醒 DSH 定时任务 (fork of dsh-slack with an inbox trigger)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./slack-app-manifest.yaml": "./slack-app-manifest.yaml",
    "./client": "./lib/update-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/plugin-icon.webp"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "slack-app-manifest.yaml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp",
    "locale"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-updates.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build",
    "test:protocol": "node test/protocol-acceptance.mjs"
  },
  "dependencies": {
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.0.0",
    "undici": "^7.0.0 || ^8.0.0",
    "@stardustlc/dsh-updates": "0.2.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itstartstosnow/dsh-slack-fork-trigger.git"
  },
  "bugs": {
    "url": "https://github.com/itstartstosnow/dsh-slack-fork-trigger/issues"
  },
  "homepage": "https://github.com/itstartstosnow/dsh-slack-fork-trigger#readme",
  "author": "stardustlc",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "ai-agent",
    "slack",
    "socket-mode",
    "chatops",
    "notification"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "icon": "./assets/plugin-icon.webp"
}
