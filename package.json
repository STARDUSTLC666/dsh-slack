{
  "name": "dsh-slack",
  "version": "0.4.7",
  "description": "让任务通知和线程回复回到 Slack。 需要自己的 Slack App、权限和令牌 欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/update-client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-updates.mjs",
    "test": "pnpm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "pnpm run build",
    "test:protocol": "node test/protocol-acceptance.mjs"
  },
  "dependencies": {
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.0.0",
    "undici": "^7.0.0 || ^8.0.0",
    "@stardustlc/dsh-updates": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "url": "git+https://github.com/STARDUSTLC666/dsh-slack.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-slack/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-slack#readme",
  "author": "stardustlc",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "icon": "./assets/plugin-icon.webp"
}
