{
  "name": "dsh-slack",
  "version": "0.3.1",
  "description": "DSH 社区插件：Slack 通知/桥接（v0.2 支持 Socket Mode 双向：收件箱 + 线程回复）",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.8": "unknown",
        "0.1.1-rc.1": "unknown",
        "0.1.1-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "pnpm run build",
    "test:protocol": "node test/protocol-acceptance.mjs"
  },
  "dependencies": {
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "url": "git+https://github.com/STARDUSTLC666/dsh-slack.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-slack/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-slack#readme",
  "author": "stardustlc",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  }
}
